# Trace - example environment variables. Copy it: cp .env.example .env.local
# Never commit real keys to the repository.

# Demo login password (login is impossible if not set)
DEMO_PASSCODE=

# Primary Meta Model API key (shared by Transcribe + SAM 3.1 + chat)
MODEL_API_KEY=

# File-compiler role (active: Muse Spark 1.3) - optional; otherwise the shared chat layer is used
# PROSECUTOR_API_URL=https://api.meta.ai/v1/chat/completions
# PROSECUTOR_MODEL=muse-spark-1.3
# PROSECUTOR_API_KEY=

# Similarity-judge role (active: Muse Wonder 1.0) - optional endpoint/model overrides
# JUDGE_API_URL=https://api.meta.ai/v1/chat/completions
# JUDGE_MODEL=muse-wonder-1.0

# Baseten path for the judge (preferred over the Meta API when set)
# BASETEN_API_KEY=
# BASETEN_API_URL=https://inference.baseten.co/v1/chat/completions
# SPARK_MODEL=muse-spark-open

# Model overrides (defaults: muse-voice-transcribe-1.0 / sam-3.1)
# META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# META_SAM_MODEL=sam-3.1

# Number of similar cases shown (default 5)
# SIMILAR_RESULT_LIMIT=5

# Persistent data paths (set by compose in Docker)
# TRACE_DB_PATH=trace.db
# TRACE_UPLOAD_DIR=uploads
